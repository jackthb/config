#!/bin/zsh
# Claude Code config sync status & management
# Shows the state of all skills and settings across repo and local

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_DIR="$HOME/.claude"
REPO_COMMANDS="$REPO_DIR/.claude/commands"
LOCAL_COMMANDS="$CLAUDE_DIR/commands"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

show_status() {
    echo -e "${BOLD}Claude Code Sync Status${NC}"
    echo ""

    # Settings status
    echo -e "${BOLD}Settings${NC}"
    for file in settings.json statusline-command.sh; do
        target="$CLAUDE_DIR/$file"
        source="$REPO_DIR/.claude/$file"
        if [[ -L "$target" ]]; then
            link="$(readlink -f "$target")"
            expected="$(readlink -f "$source")"
            if [[ "$link" == "$expected" ]]; then
                echo -e "  ${GREEN}synced${NC}  $file"
            else
                echo -e "  ${BLUE}extern${NC}  $file -> $link"
            fi
        elif [[ -f "$target" && -f "$source" ]]; then
            if diff -q "$target" "$source" &>/dev/null; then
                echo -e "  ${YELLOW}copy${NC}    $file ${DIM}(identical but not linked)${NC}"
            else
                echo -e "  ${RED}conflict${NC} $file ${DIM}(local differs from repo)${NC}"
            fi
        elif [[ -f "$target" ]]; then
            echo -e "  ${YELLOW}local${NC}   $file"
        elif [[ -f "$source" ]]; then
            echo -e "  ${DIM}missing${NC} $file ${DIM}(in repo, not linked)${NC}"
        fi
    done
    echo ""

    # Skills/commands status
    echo -e "${BOLD}Skills${NC}"

    # Collect all skill names from both locations
    local skills=()
    [[ -d "$REPO_COMMANDS" ]] && skills+=("$REPO_COMMANDS"/*.md(N:t))
    [[ -d "$LOCAL_COMMANDS" ]] && skills+=("$LOCAL_COMMANDS"/*.md(N:t))
    skills=(${(u)${(o)skills[@]}})

    if [[ ${#skills[@]} -eq 0 ]]; then
        echo -e "  ${DIM}no skills found${NC}"
    fi

    for skill in "${skills[@]}"; do
        local_file="$LOCAL_COMMANDS/$skill"
        repo_file="$REPO_COMMANDS/$skill"
        name="${skill%.md}"

        if [[ -L "$local_file" ]]; then
            link="$(readlink -f "$local_file")"
            expected="$(readlink -f "$repo_file" 2>/dev/null || echo "")"
            if [[ "$link" == "$expected" ]]; then
                echo -e "  ${GREEN}synced${NC}  $name"
            else
                echo -e "  ${BLUE}extern${NC}  $name -> $link"
            fi
        elif [[ -f "$local_file" && -f "$repo_file" ]]; then
            if diff -q "$local_file" "$repo_file" &>/dev/null; then
                echo -e "  ${YELLOW}copy${NC}    $name ${DIM}(identical but not linked)${NC}"
            else
                echo -e "  ${RED}conflict${NC} $name ${DIM}(local differs from repo)${NC}"
            fi
        elif [[ -f "$local_file" ]]; then
            echo -e "  ${YELLOW}local${NC}   $name"
        elif [[ -f "$repo_file" ]]; then
            echo -e "  ${DIM}missing${NC} $name ${DIM}(in repo, not linked)${NC}"
        fi
    done
    echo ""

    # Local-only settings
    if [[ -f "$CLAUDE_DIR/settings.local.json" ]]; then
        echo -e "${BOLD}Local Settings${NC}"
        echo -e "  ${DIM}settings.local.json (never synced)${NC}"
        echo ""
    fi
}

do_sync() {
    echo -e "${BOLD}Syncing Claude Code config...${NC}"
    echo ""

    # Remove existing non-symlink files that stow needs to replace
    if [[ -d "$REPO_COMMANDS" ]]; then
        for f in "$REPO_COMMANDS"/*.md; do
            [[ -f "$f" ]] || continue
            name="$(basename "$f")"
            target="$LOCAL_COMMANDS/$name"
            if [[ -f "$target" && ! -L "$target" ]]; then
                if diff -q "$target" "$f" &>/dev/null; then
                    echo -e "  ${GREEN}replacing copy${NC} $name with symlink"
                    rm "$target"
                else
                    echo -e "  ${RED}conflict${NC} $name - local differs from repo"
                    echo -n "    Override local? [y/N] "
                    read -n 1 -r < /dev/tty
                    echo ""
                    if [[ $REPLY =~ ^[Yy]$ ]]; then
                        rm "$target"
                    else
                        echo "    Skipping $name"
                        continue
                    fi
                fi
            fi
        done
    fi

    # Run stow
    cd "$REPO_DIR"
    stow -v -t ~ claude 2>&1 | while read -r line; do
        echo -e "  ${DIM}$line${NC}"
    done

    echo ""
    echo -e "${GREEN}Done!${NC}"
    echo ""
    show_status
}

add_skill() {
    local skill_path="$1"
    if [[ -z "$skill_path" ]]; then
        echo "Usage: claude-sync add <skill-name-or-path>"
        echo "  Moves a local-only skill into the synced repo"
        exit 1
    fi

    # Resolve to a .md file in commands/
    if [[ ! "$skill_path" == *.md ]]; then
        skill_path="${skill_path}.md"
    fi
    if [[ ! -f "$skill_path" ]]; then
        skill_path="$LOCAL_COMMANDS/$skill_path"
    fi

    if [[ ! -f "$skill_path" ]]; then
        echo -e "${RED}Skill not found: $skill_path${NC}"
        exit 1
    fi

    if [[ -L "$skill_path" ]]; then
        echo -e "${YELLOW}Already a symlink: $skill_path${NC}"
        exit 1
    fi

    local name="$(basename "$skill_path")"
    echo -e "Moving ${BOLD}${name%.md}${NC} to synced repo..."
    cp "$skill_path" "$REPO_COMMANDS/$name"
    rm "$skill_path"

    cd "$REPO_DIR"
    stow -v -t ~ claude 2>&1 | while read -r line; do
        echo -e "  ${DIM}$line${NC}"
    done

    echo -e "${GREEN}Done!${NC} ${name%.md} is now synced."
}

case "${1:-status}" in
    status)
        show_status
        ;;
    sync)
        do_sync
        ;;
    add)
        add_skill "$2"
        ;;
    *)
        echo "Usage: claude-sync [status|sync|add <skill>]"
        echo ""
        echo "Commands:"
        echo "  status  Show sync state of all skills and settings (default)"
        echo "  sync    Re-run stow to link repo config into ~/.claude/"
        echo "  add     Move a local-only skill into the synced repo"
        ;;
esac
